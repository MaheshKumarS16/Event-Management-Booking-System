PORT=5000
NODE_ENV=development
# MongoDB connection URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/eventify_db
# For MongoDB Atlas in production:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventify?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
